# Copy to .env.cloud, generate both secrets, fill every blank required value,
# then create the workspace root on the Docker host before starting the stack.
POSTGRES_USER=ai_sdlc
POSTGRES_PASSWORD=
POSTGRES_DB=ai_sdlc

AI_SDLC_ACCESS_TOKEN=
AI_SDLC_ALLOWED_ORIGINS=http://localhost:8080
AI_SDLC_WEB_PORT=8080
# Keep loopback and terminate TLS in a reverse proxy for remote access.
AI_SDLC_WEB_BIND_HOST=127.0.0.1

# This must be an existing, dedicated, absolute directory on the Docker host.
# It is intentionally mounted at the same absolute path inside the trusted API.
AI_SDLC_HOST_WORKSPACE_ROOT=
# Linux: set this to `stat -c %g /var/run/docker.sock`. Docker Desktop commonly uses 0.
AI_SDLC_DOCKER_GID=

AI_SDLC_GIT_ALLOWED_ORIGINS=https://github.com,https://gitlab.com,https://bitbucket.org
AI_SDLC_GIT_ALLOW_PRIVATE_NETWORKS=0
AI_SDLC_GIT_TIMEOUT_MS=120000
AI_SDLC_GIT_MAX_REPOSITORY_BYTES=536870912
AI_SDLC_GIT_MAX_FILES=100000

# Optional operator-installed stdio MCP adapters for Jira, Linear, or another
# work tracker. See .env.example for the full JSON shape. Secrets are referenced
# by environment-variable name and never included in browser requests.
# AI_SDLC_WORK_ITEM_MCP_ADAPTERS=[]
AI_SDLC_WORK_ITEM_MCP_TIMEOUT_MS=20000
AI_SDLC_WORK_ITEM_MCP_MAX_OUTPUT_BYTES=2097152
AI_SDLC_WORK_ITEM_MCP_MAX_CONCURRENT=4
# Optional host directory containing operator-installed adapter binaries/scripts.
# It is mounted read-only at /opt/ai-sdlc/mcp-bin in the API container.
# AI_SDLC_MCP_BIN_ROOT=./mcp-bin

AI_SDLC_WORKER_IMAGE=ai-sdlc-worker:local
# Optional named/versioned choices shown after repository binding. The runtime
# image remains AI_SDLC_WORKER_IMAGE and cannot be selected by the browser/repo.
# AI_SDLC_SANDBOX_BLUEPRINTS=[{"id":"default","label":"Managed default","version":"1","description":"Restricted Node/Git agent workspace","default":true}]
AI_SDLC_WORKER_NETWORK=bridge
AI_SDLC_WORKER_USER=10001:10001
AI_SDLC_WORKER_CPUS=2
AI_SDLC_WORKER_MEMORY=4g
AI_SDLC_WORKER_PIDS_LIMIT=256
AI_SDLC_WORKER_TMPFS_SIZE=512m
# Real phase execution is denied unless the exact imported repository URL is
# listed here. Import, DeepWiki, Ask and Fake mode do not require this trust grant.
# Use a separate low-quota, quickly rotatable model key for these Workers.
AI_SDLC_REAL_EXECUTION_TRUSTED_REPOSITORIES=
# Process-local safety cap. MVP does not queue excess real phases; it returns 429.
AI_SDLC_MAX_CONCURRENT_PHASES=1
AI_SDLC_CODEX_FAKE=0
# Real mode may not skip the daemon/version/image startup gate.
AI_SDLC_CLOUD_SKIP_DOCKER_PREFLIGHT=0
AI_SDLC_CODEX_MODELS=gpt-5.6-terra
AI_SDLC_CODEX_REASONING_EFFORTS=low,medium,high,xhigh
AI_SDLC_CODEX_DEFAULT_MODEL=gpt-5.6-terra
AI_SDLC_CODEX_DEFAULT_REASONING_EFFORT=high

# Ask providers are optional and server-only. Configure one or more.
AI_SDLC_ASK_OPENAI_MODEL=gpt-5.6-terra
# AI_SDLC_ASK_OPENAI_API_KEY=

# To reach LM Studio or Ollama running on the Docker host, use the Compose
# host.docker.internal mapping. This is plaintext HTTP, so it requires an
# explicit opt-in and should stay on a trusted host/network.
# AI_SDLC_ASK_LM_STUDIO_MODEL=openai/gpt-oss-20b
# AI_SDLC_ASK_LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
# AI_SDLC_ASK_LM_STUDIO_ALLOW_INSECURE_HTTP=1
# AI_SDLC_ASK_LM_STUDIO_TOOL_CALLING=0
# AI_SDLC_ASK_OLLAMA_MODEL=qwen3-coder:latest
# AI_SDLC_ASK_OLLAMA_BASE_URL=http://host.docker.internal:11434
# AI_SDLC_ASK_OLLAMA_ALLOW_INSECURE_HTTP=1
# AI_SDLC_ASK_OLLAMA_TOOL_CALLING=0

# The phase Worker currently uses Codex CLI as its controlled execution kernel.
# OPENAI_API_KEY=
