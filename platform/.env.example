# Local-only PostgreSQL settings used by docker-compose.yml.
POSTGRES_USER=ai_sdlc
POSTGRES_PASSWORD=ai_sdlc_dev
POSTGRES_DB=ai_sdlc
POSTGRES_PORT=54329
DATABASE_URL=postgresql://ai_sdlc:ai_sdlc_dev@localhost:54329/ai_sdlc

# Platform servers.
HOST=127.0.0.1
PORT=4100
VITE_API_URL=http://localhost:4100

# Single-tenant Cloud access. A non-loopback HOST refuses to start without a
# strong token. The browser asks the operator/user for this value and keeps it
# in sessionStorage only; do not bake it into VITE_* variables.
# AI_SDLC_ACCESS_TOKEN=replace-with-at-least-24-random-characters
# Exact comma-separated browser origins. Required for a remote Web deployment.
# AI_SDLC_ALLOWED_ORIGINS=https://sdlc.example.com

# Server-managed remote Git workspaces. Use a dedicated persistent directory;
# never point this at a home directory or an existing source checkout.
AI_SDLC_MANAGED_WORKSPACE_ROOT=.data/cloud-workspaces
# Exact HTTPS origins, not host suffixes or wildcards.
AI_SDLC_GIT_ALLOWED_ORIGINS=https://github.com,https://gitlab.com,https://bitbucket.org
# Private/loopback/link-local repository endpoints are denied by default. Set
# this only for a trusted self-hosted Git network and keep the origin allowlist exact.
AI_SDLC_GIT_ALLOW_PRIVATE_NETWORKS=0
AI_SDLC_GIT_TIMEOUT_MS=120000
AI_SDLC_GIT_MAX_OUTPUT_BYTES=2097152
AI_SDLC_GIT_MAX_REPOSITORY_BYTES=536870912
AI_SDLC_GIT_MAX_FILES=100000

# Optional private-repository profiles. This JSON contains only metadata and
# the *name* of another environment variable that holds the token.
# AI_SDLC_GIT_CREDENTIAL_PROFILES=[{"id":"github-team","label":"GitHub Team","origin":"https://github.com","secretEnv":"GITHUB_TEAM_TOKEN","username":"x-access-token"}]
# GITHUB_TEAM_TOKEN=

# Optional Jira/Linear/other Work Item MCP adapters. The browser receives only
# id/label/availability and may submit only adapterId + reference. command,
# args, tool name, fixed arguments and secret mapping stay server-owned. Use an
# absolute executable installed in the API runtime; a stdio bridge such as an
# operator-pinned mcp-remote installation can front a remote MCP endpoint.
# AI_SDLC_WORK_ITEM_MCP_ADAPTERS=[{"id":"linear-main","label":"Linear","command":"/opt/ai-sdlc/mcp-bin/linear-mcp","args":[],"toolName":"get_issue","referenceArgument":"issueId","fixedArguments":{},"secretEnv":{"LINEAR_API_TOKEN":"AI_SDLC_LINEAR_API_TOKEN"},"mapping":{"title":"issue.title","description":"issue.description","externalId":"issue.identifier","url":"issue.url","labels":"issue.labels"},"defaultWorkType":"feature"}]
# AI_SDLC_LINEAR_API_TOKEN=
AI_SDLC_WORK_ITEM_MCP_TIMEOUT_MS=20000
AI_SDLC_WORK_ITEM_MCP_MAX_OUTPUT_BYTES=2097152
# Hard process cap, not a remote-readiness signal. Excess requests receive 429.
AI_SDLC_WORK_ITEM_MCP_MAX_CONCURRENT=4

# Remote real runs fail closed unless an operator-approved Worker image is set.
# Build it with: docker build -f docker/worker.Dockerfile -t ai-sdlc-worker:local ..
# AI_SDLC_WORKER_IMAGE=ai-sdlc-worker:local
# Optional public Blueprint catalog. Entries never carry an image or command;
# every entry is bound server-side to the one Worker image approved at startup.
# AI_SDLC_SANDBOX_BLUEPRINTS=[{"id":"default","label":"Managed default","version":"1","description":"Restricted Node/Git agent workspace","default":true}]
AI_SDLC_DOCKER_BIN=docker
AI_SDLC_WORKER_NETWORK=bridge
# Must match the uid:gid of the API process so cloned files are writable in the
# Worker. When omitted on POSIX, the API uses its own non-root uid:gid.
# AI_SDLC_WORKER_USER=10001:10001
AI_SDLC_WORKER_CPUS=2
AI_SDLC_WORKER_MEMORY=4g
AI_SDLC_WORKER_PIDS_LIMIT=256
AI_SDLC_WORKER_TMPFS_SIZE=512m
AI_SDLC_WORKER_CODEX_BIN=codex
# Comma-separated exact HTTPS repository URLs allowed to enter a real Worker.
# Empty means remote real execution fails closed; Fake mode still works.
AI_SDLC_REAL_EXECUTION_TRUSTED_REPOSITORIES=
AI_SDLC_MAX_CONCURRENT_PHASES=1

# Project access and local command execution.
# Separate multiple absolute roots with the host OS path delimiter (`:` on macOS/Linux).
AI_SDLC_ALLOWED_PROJECT_ROOTS=/absolute/path/to/projects
AI_SDLC_CODEX_BIN=codex
AI_SDLC_CODEX_TIMEOUT_MS=1800000

# The API discovers this repository's existing initializer automatically.
# Only set an override when necessary, and use an absolute path.
# AI_SDLC_CLI_PATH=/absolute/path/to/my-sdlc-workflow/bin/cli.js

# Local development starts as a deterministic demo and explicitly skips the
# Docker preflight. Cloud .env uses real mode and cannot bypass the check.
AI_SDLC_CODEX_FAKE=1
AI_SDLC_CLOUD_SKIP_DOCKER_PREFLIGHT=1

# 对话与 DeepWiki Provider 在 Web 的“模型设置”中配置。
# 页面保存后立即生效；endpoint、model 和 API key 不进入 .env，也不需要重启 API。
# 本地 Docker 访问宿主上的 LM Studio / Ollama 时，在页面填写 host.docker.internal。
