{
  "name": "@ai-sdlc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test checks/**/*.check.ts",
    "test:docker-smoke": "AI_SDLC_RUN_DOCKER_SMOKE=1 node --import tsx --test checks/cloud-docker-smoke.check.ts"
  },
  "dependencies": {
    "@ai-sdlc/contracts": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
