{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-native SDLC configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateSet",
    "project",
    "paths",
    "integrations",
    "roles",
    "workflow",
    "baselines",
    "artifacts",
    "generation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "templateSet": {
      "const": "core/v1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "owner", "locale", "stack", "commands"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "locale": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "stack": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup", "build", "test", "lint"],
          "properties": {
            "setup": { "type": "string" },
            "build": { "type": "string" },
            "test": { "type": "string" },
            "lint": { "type": "string" }
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "roles", "artifacts"],
      "properties": {
        "baseline": { "$ref": "#/definitions/relativePath" },
        "roles": { "$ref": "#/definitions/relativePath" },
        "artifacts": { "$ref": "#/definitions/relativePath" }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubCopilot", "claudeCode", "codex"],
      "properties": {
        "githubCopilot": { "type": "boolean" },
        "claudeCode": { "type": "boolean" },
        "codex": { "type": "boolean" }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/role" }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases", "definitionOfDone"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/phase" }
        },
        "definitionOfDone": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/baseline" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifact" }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxParallelAgents"],
      "properties": {
        "maxParallelAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  },
  "definitions": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "enabled", "mission", "responsibilities", "deliverables"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*$",
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "enabled": { "type": "boolean" },
        "mission": { "type": "string", "minLength": 1, "maxLength": 500 },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "deliverables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "inputs", "outputs", "gate"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "owner": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gate": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "template", "output"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "title": { "type": "string", "minLength": 1 },
        "template": {
          "enum": ["project-charter", "workflow", "definition-of-done", "role-registry"]
        },
        "output": { "$ref": "#/definitions/relativePath" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "owner", "template", "output", "mode"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "title": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "template": {
          "enum": [
            "product-brief",
            "requirements",
            "design-spec",
            "architecture",
            "implementation-plan",
            "test-plan",
            "release-runbook"
          ]
        },
        "output": { "$ref": "#/definitions/relativePath" },
        "mode": { "const": "seed" }
      }
    }
  }
}
